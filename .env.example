# MediGuard Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual credentials.
#
# Build or run with:
# flutter run --dart-define-from-file=.env
# flutter build apk --dart-define-from-file=.env

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-jwt-or-publishable-key

# OneSignal Push Notification Configuration
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
